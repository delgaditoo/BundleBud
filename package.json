{
  "name": "ai-file-organizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://localhost:5173 && wait-on electron-dist/electron/main.js && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json && electron-builder",
    "preview": "vite preview",
    "electron": "tsc -p tsconfig.electron.json && electron ."
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ai.fileorganizer",
    "productName": "AI File Organizer",
    "files": [
      "dist",
      "electron-dist",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    }
  }
}
